  "components": {
    "schemas": {
      "Body_upload_api_jobs__job__attachments_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_jobs__job__attachments_post"
      },
      "Contact": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Id"
          },
          "on": {
            "type": "string",
            "format": "date",
            "title": "On"
          },
          "kind": {
            "type": "string",
            "enum": [
              "human",
              "receipt",
              "outbound"
            ],
            "title": "Kind"
          },
          "source": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Source"
          },
          "summary": {
            "type": "string",
            "maxLength": 4000,
            "title": "Summary",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "on",
          "kind",
          "source"
        ],
        "title": "Contact"
      },
      "Counts": {
        "properties": {
          "open_applications": {
            "type": "integer",
            "title": "Open Applications"
          },
          "passive_waiting": {
            "type": "integer",
            "title": "Passive Waiting"
          },
          "attention": {
            "type": "integer",
            "title": "Attention"
          },
          "parked": {
            "type": "integer",
            "title": "Parked"
          },
          "interviewing_companies": {
            "type": "integer",
            "title": "Interviewing Companies"
          },
          "weekly_new": {
            "type": "integer",
            "title": "Weekly New"
          },
          "unknown_application_dates": {
            "type": "integer",
            "title": "Unknown Application Dates"
          }
        },
        "type": "object",
        "required": [
          "open_applications",
          "passive_waiting",
          "attention",
          "parked",
          "interviewing_companies",
          "weekly_new",
          "unknown_application_dates"
        ],
        "title": "Counts"
      },
      "Credential": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$",
            "title": "Name"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Scopes"
          },
          "jobs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Jobs",
            "default": []
          },
          "days": {
            "type": "integer",
            "maximum": 90.0,
            "minimum": 1.0,
            "title": "Days",
            "default": 30
          }
        },
        "type": "object",
        "required": [
          "name",
          "scopes"
        ],
        "title": "Credential"
      },
      "Decision": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "company": {
            "type": "string",
            "title": "Company"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          },
          "next_action": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NextAction"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "company",
          "title",
          "status",
          "label",
          "reasons"
        ],
        "title": "Decision"
      },
      "DerivedJob": {
        "properties": {
          "record_version": {
            "type": "integer",
            "title": "Record Version",
            "default": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "terminal",
              "backlog",
              "action_due",
              "action_needed",
              "parked",
              "interview_scheduled",
              "interview_review",
              "promise_waiting",
              "promise_review",
              "dates_unknown",
              "waiting",
              "waiting_badge",
              "review_due",
              "offer_review"
            ],
            "title": "Status"
          },
          "label": {
            "type": "string",
