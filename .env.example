# Synthetic loopback demo only. The server does not automatically load this file;
# export selected values explicitly as described in README.md. No credentials.
APP_ENV=development
TRACKER_DEMO=1
DEMO_DATA_DIR=.demo-data
PUBLIC_BASE_URL=
# Inert signing identity for forks; this does not configure or enable native auth.
MOBILE_APP_ID=EXAMPLE123.com.example.fieldnotes
# Real Apple configuration belongs in private runtime storage, never in Git.
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=
APPLE_OWNER_SUB=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=
